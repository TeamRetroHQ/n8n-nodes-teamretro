    {
      "id": "tr1900-0000-0000-0000-000000000012",
      "name": "One Item per Blocker",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        300
      ],
      "parameters": {
        "jsCode": "const { blockerTopic } = $('Settings').first().json;\nconst standup = $('When Standup Closes').first().json.data.standup;\nconst blockers = [];\nfor (const { participant, topics } of standup.updates || []) {\n  for (const { topic, updates } of topics) {\n    if (!topic.title.toLowerCase().includes(String(blockerTopic).toLowerCase())) continue;\n    for (const update of updates) {\n      blockers.push({ json: {\n        updateId: update.id,\n        carriedFromId: update.carriedFromStandupUpdateId || '',\n        standupsOpen: update.carriedForwardCount + 1,\n        person: participant.name || 'A team member',\n        text: update.text,\n        team: standup.team.name,\n        date: standup.date,\n      } });\n    }\n  }\n}\nreturn blockers;"
      }
    },
