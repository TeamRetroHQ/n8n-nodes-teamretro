        364,
        124
      ],
      "parameters": {
        "content": "## 1. Catch the closed standup\n\nFires when a standup closes. Retries, and a second run of the pinned sample, stop at the duplicate check.",
        "height": 384,
        "width": 736,
        "color": 7
      }
    },
    {
